// Qwen3.8-Flash-Next (GGUF general.architecture "qwen4exp").
//
// Everything GGUF exposes is read from the GGUF at load; this file carries only
// policy this model differs on.
{
    "schema": 1,
    "arch": "qwen4exp",
    "overrides": {
        "prefill": {
            // --gpu prefill reads the next layer's experts ahead (2026-10-08, 24 GiB,
            // 3,264-token prompt, off/on/on/off): 63.7/63.4 s -> 53.0/56.2 s, bytes
            // 193.3 -> 245.5 GB, same text.
            "gpu_read_ahead": true
        }
    }
}
